# Copy to .env and fill in. In a worktree, `npm run linkenv` symlinks ../../.env instead.

# Postgres connection string. Point this at a dev database locally, never production.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wcdd"

# Basic-auth credentials for /admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Texts about new contact form submissions. Comma-separated E.164 numbers; leave empty to
# send none. Use only your own number in dev.
SMS_NOTIFY_TO="+14035550100"
# Twilio credentials (console.twilio.com) and the Twilio number texts are sent from.
# Only needed when SMS_NOTIFY_TO is set.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+14035550199"
