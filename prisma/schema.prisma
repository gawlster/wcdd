// When making changes, run `npx prisma migrate dev --name <name>` against a dev database
// (add `--create-only` to review/edit the SQL first, e.g. to backfill data).
// Then run `npx prisma generate` to generate a new prisma client with the new schema.
// Production applies committed migrations with `npx prisma migrate deploy`.

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum ContactMethod {
    phone
    email
}

model ContactSubmission {
    id               Int            @id @default(autoincrement())
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @default(now()) @updatedAt
    respondedAt      DateTime?
    name             String
    email            String
    phone            String
    message          String
    // Both null on rows submitted before they were added to the form
    /// A package `id` from src/content/packages.ts, or "not-sure"
    packageId        String?
    preferredContact ContactMethod?

    @@index([createdAt])
    // Table keeps its original name; renaming it would break the previous release mid-deploy
    @@map("FormSubmission")
}
